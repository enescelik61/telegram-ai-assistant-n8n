      "parameters": {
        "jsCode": "const raw = $json.content.parts[0].text;\n\nlet parsed;\ntry {\n  parsed = JSON.parse(raw);\n} catch(e) {\n  const match = raw.match(/\\{[\\s\\S]*\\}/);\n  parsed = JSON.parse(match[0]);\n}\n\nreturn [{ json: parsed }];"
      },
